#!/bin/bash
# Liquid Glass screensaver: starts the style picked in ~/.config/liquid-glass/screensaver.toml
# ("retro" = stylised 24h sky, "sun" = real sun position and light). LG_STYLE overrides it.

conf="$HOME/.config/liquid-glass/screensaver.toml"
style=${LG_STYLE:-$(sed -n 's/^style *= *"\([a-z]*\)".*/\1/p' "$conf" 2>/dev/null)}
[[ $style == sun ]] || style=retro

exec "$(dirname "$(realpath "$0")")/liquid-glass-$style" "$@"
