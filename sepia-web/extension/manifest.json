{
  "manifest_version": 3,
  "name": "Omarchy Sepia Web",
  "version": "1.0.0",
  "description": "Replaces white page backgrounds with the sepia color of the Liquid Glass Warm theme — only while that Omarchy theme is active.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "alarms"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
